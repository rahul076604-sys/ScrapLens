        </div>


        <!-- 9. PLASTIC -->

        <div class="category-card">

            <div class="category-icon">
                🧴
            </div>

            <h3>Plastic</h3>

            <p>
                Plastic bottles, containers and
                packaging materials.
            </p>

            <span class="badge recyclable">
                Recyclable
            </span>

            <div class="learn-more">
                Learn More →
            </div>

        </div>


        <!-- 10. SHOES -->

        <div class="category-card">

            <div class="category-icon">
                👟
            </div>

            <h3>Shoes</h3>

            <p>
                Used footwear and shoe materials
